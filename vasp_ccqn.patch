+                    '1X,I1,1X,F10.4,1X,E12.4,1X,E12.4)') &
+            iter, epot, fmax, neg_count, min_eig, phase, delta, step_norm, cos_es, &
+            MERGE(1,0,have_ratio), ratio, pred, dE

+        SUBROUTINE pack3(nions, v3, v)
+          INTEGER, INTENT(IN) :: nions
+          REAL(q), INTENT(IN) :: v3(3,nions)
+          REAL(q), INTENT(OUT) :: v(3*nions)
+          INTEGER :: i, j
+          DO i=1,nions
+            DO j=1,3
+              v(3*(i-1)+j) = v3(j,i)
+            END DO
+          END DO
+        END SUBROUTINE pack3
+
+
+        SUBROUTINE unpack3(nions, v, v3)
+          INTEGER, INTENT(IN) :: nions
+          REAL(q), INTENT(IN) :: v(3*nions)
+          REAL(q), INTENT(OUT) :: v3(3,nions)
+          INTEGER :: i, j
+          DO i=1,nions
+            DO j=1,3
+              v3(j,i) = v(3*(i-1)+j)
+            END DO
+          END DO
+        END SUBROUTINE unpack3
+
+
+        SUBROUTINE apply_selective_mask(T_INFO, v)
+          TYPE(type_info), INTENT(IN) :: T_INFO
+          REAL(q), INTENT(INOUT) :: v(3*T_INFO%NIONS)
+          INTEGER :: i, j, k
+          IF (.NOT. T_INFO%LSDYN) RETURN
+          DO i=1,T_INFO%NIONS
+            DO j=1,3
+              k = 3*(i-1)+j
+              IF (.NOT. T_INFO%LSFOR(j,i)) v(k) = 0._q
+            END DO
+          END DO
+        END SUBROUTINE apply_selective_mask
+
+
+        SUBROUTINE mic_cart(dvec, LATT_CUR)
+          ! Minimum-image convention for a Cartesian difference vector.
+          REAL(q), INTENT(INOUT) :: dvec(3)
+          TYPE(latt), INTENT(IN) :: LATT_CUR
+          REAL(q) :: dfrac(3)
+          INTEGER :: i
+          ! frac_i = sum_j B(j,i) * cart_j   (VASP KARDIR convention)
+          DO i=1,3
+            dfrac(i) = LATT_CUR%B(1,i)*dvec(1) + LATT_CUR%B(2,i)*dvec(2) + LATT_CUR%B(3,i)*dvec(3)
+          END DO
+          dfrac = dfrac - NINT(dfrac)
+          ! cart_i = sum_j A(i,j) * frac_j   (VASP DIRKAR convention)
+          DO i=1,3
+            dvec(i) = LATT_CUR%A(i,1)*dfrac(1) + LATT_CUR%A(i,2)*dfrac(2) + LATT_CUR%A(i,3)*dfrac(3)
+          END DO
+        END SUBROUTINE mic_cart
+
+
+        SUBROUTINE compute_e_ic(nions, nbonds, bonds, pos, forces, LATT_CUR, e3)
+          ! Paper Algorithm 2, with minimum-image treatment of bond vectors.
+          INTEGER, INTENT(IN)  :: nions, nbonds
+          INTEGER, INTENT(IN)  :: bonds(2, nbonds)
+          REAL(q), INTENT(IN)  :: pos(3, nions)
+          REAL(q), INTENT(IN)  :: forces(3, nions)
+          TYPE(latt), INTENT(IN) :: LATT_CUR
+          REAL(q), INTENT(OUT) :: e3(3, nions)
+
+          INTEGER :: k, ii, jj
+          REAL(q) :: v_ij(3), v_norm2, proj_j, proj_i, p_ij(3), p_norm
+
+          e3 = 0._q
+
+          DO k = 1, nbonds
+            ii = bonds(1, k)
+            jj = bonds(2, k)
+
+            v_ij = pos(:, jj) - pos(:, ii)
+            CALL mic_cart(v_ij, LATT_CUR)
+            v_norm2 = SUM(v_ij * v_ij)
+            IF (v_norm2 < 1E-12_q) CYCLE
+
+            proj_j = SUM(v_ij * forces(:, jj)) / v_norm2
+            proj_i = SUM(v_ij * forces(:, ii)) / v_norm2
+
+            p_ij = v_ij * (proj_j - proj_i)
+            p_norm = SQRT(SUM(p_ij * p_ij))
+            IF (p_norm < 1E-12_q) CYCLE
+
+            p_ij = p_ij / p_norm
+            e3(:, ii) = e3(:, ii) + p_ij
+            e3(:, jj) = e3(:, jj) - p_ij
+          END DO
+        END SUBROUTINE compute_e_ic
+
+
+        SUBROUTINE compute_e_interp(nions, x, x_final, LATT_CUR, e)
+          ! Interpolation mode (paper eq 18, linear midpoint): the direction to
+          ! the midpoint of the linear path equals the direction to the final
+          ! state, taken per atom with minimum image.
+          INTEGER, INTENT(IN) :: nions
+          REAL(q), INTENT(IN) :: x(3*nions), x_final(3*nions)
+          TYPE(latt), INTENT(IN) :: LATT_CUR
+          REAL(q), INTENT(OUT) :: e(3*nions)
+
+          INTEGER :: i
+          REAL(q) :: d(3)
+
+          DO i=1,nions
+            d = x_final(3*(i-1)+1:3*(i-1)+3) - x(3*(i-1)+1:3*(i-1)+3)
+            CALL mic_cart(d, LATT_CUR)
+            e(3*(i-1)+1:3*(i-1)+3) = d
+          END DO
+        END SUBROUTINE compute_e_interp
+
+
+        SUBROUTINE read_final_poscar(fname, nions, LATT_CUR, x_final)
+          ! Lightweight POSCAR reader for the interpolation mode. Supports
+          ! VASP5+ format (element-symbol line optional), Selective dynamics,
+          ! Direct and Cartesian coordinates. Atom count and order must match
+          ! the running POSCAR. Own lattice header is read (scale applied) but
+          ! coordinates are mapped into the CURRENT cell for Direct input.
+          CHARACTER(LEN=*), INTENT(IN) :: fname
+          INTEGER, INTENT(IN) :: nions
+          TYPE(latt), INTENT(IN) :: LATT_CUR
+          REAL(q), INTENT(OUT) :: x_final(3*nions)
+
+          INTEGER :: iu, ierr, ios, i, j, ntot
+          REAL(q) :: scalef, a_lat(3,3), r(3), rc(3)
+          INTEGER :: counts(64)
+          CHARACTER(LEN=512) :: line
+          CHARACTER(LEN=768) :: padded
+          CHARACTER(LEN=1) :: c1
+          LOGICAL :: is_direct
+
+          OPEN(NEWUNIT=iu, FILE=TRIM(fname), STATUS='OLD', ACTION='READ', IOSTAT=ierr)
+          IF (ierr /= 0) THEN
+            CALL vtutor%error("ERROR: CCQN-TS: could not open FINAL_POSCAR file '" // &
+                              TRIM(fname) // "'.")
+          END IF
+
+          READ(iu,'(A)',IOSTAT=ios) line                 ! comment
+          IF (ios /= 0) CALL ccqn_fp_err(fname)
+          READ(iu,*,IOSTAT=ios) scalef                   ! universal scale
+          IF (ios /= 0) CALL ccqn_fp_err(fname)
+          DO i=1,3
+            READ(iu,*,IOSTAT=ios) (a_lat(j,i), j=1,3)    ! lattice vector i in rows
+            IF (ios /= 0) CALL ccqn_fp_err(fname)
+          END DO
+          IF (scalef > 0._q) a_lat = a_lat * scalef
+          ! (negative scale = target volume; not needed for direction estimate,
+          !  Direct coordinates are mapped through the current cell anyway)
+
+          READ(iu,'(A)',IOSTAT=ios) line                 ! symbols or counts
+          IF (ios /= 0) CALL ccqn_fp_err(fname)
+          READ(line,*,IOSTAT=ios) counts(1)
+          IF (ios /= 0) THEN
+            READ(iu,'(A)',IOSTAT=ios) line               ! counts after symbol line
+            IF (ios /= 0) CALL ccqn_fp_err(fname)
+          END IF
+          ! Pad with -1 sentinels so a single list-directed read is well defined
+          padded = TRIM(line)
+          DO i=1,64
+            padded = TRIM(padded) // ' -1'
+          END DO
+          READ(padded,*,IOSTAT=ios) (counts(i), i=1,64)
+          IF (ios /= 0) CALL ccqn_fp_err(fname)
+          ntot = 0
+          DO i=1,64
+            IF (counts(i) >= 0) THEN
+              ntot = ntot + counts(i)
+            ELSE
+              EXIT
+            END IF
+          END DO
+          IF (ntot /= nions) THEN
+            CALL vtutor%error("ERROR: CCQN-TS: FINAL_POSCAR atom count (" // str(ntot) // &
+                              ") does not match NIONS (" // str(nions) // ").")
+          END IF
+
+          READ(iu,'(A)',IOSTAT=ios) line                 ! Selective / coord mode
+          IF (ios /= 0) CALL ccqn_fp_err(fname)
+          line = ADJUSTL(line)
+          c1 = ccqn_uppercase(line(1:1))
+          IF (c1 == 'S') THEN
+            READ(iu,'(A)',IOSTAT=ios) line               ! coord mode after Selective
+            IF (ios /= 0) CALL ccqn_fp_err(fname)
+            line = ADJUSTL(line)
+            c1 = ccqn_uppercase(line(1:1))
+          END IF
+          is_direct = .NOT. (c1 == 'C' .OR. c1 == 'K')
+          IF (.NOT. is_direct .AND. scalef <= 0._q) THEN
+            CALL vtutor%error("ERROR: CCQN-TS: FINAL_POSCAR with Cartesian coordinates " // &
+                              "requires a positive universal scale factor.")
+          END IF
+
+          DO i=1,nions
+            READ(iu,'(A)',IOSTAT=ios) line
+            IF (ios /= 0) CALL ccqn_fp_err(fname)
+            READ(line,*,IOSTAT=ios) (r(j), j=1,3)
+            IF (ios /= 0) CALL ccqn_fp_err(fname)
+            IF (is_direct) THEN
+              ! Map through the CURRENT cell so both structures share one frame
+              DO j=1,3
+                rc(j) = LATT_CUR%A(j,1)*r(1) + LATT_CUR%A(j,2)*r(2) + LATT_CUR%A(j,3)*r(3)
+              END DO
+            ELSE
+              rc = r
+              IF (scalef > 0._q) rc = rc * scalef
+            END IF
+            x_final(3*(i-1)+1:3*(i-1)+3) = rc
+          END DO
+          CLOSE(iu)
+        END SUBROUTINE read_final_poscar
+
+
+        SUBROUTINE ccqn_fp_err(fname)
+          CHARACTER(LEN=*), INTENT(IN) :: fname
+          CALL vtutor%error("ERROR: CCQN-TS: failed to parse FINAL_POSCAR file '" // &
+                            TRIM(fname) // "' (expected standard POSCAR format).")
+        END SUBROUTINE ccqn_fp_err
+
+
+        SUBROUTINE ccqn_write_status(IU, iter, epot, fmax, neg_count, min_eig, phase, &
+                                     delta, step_norm, cos_es)
+          INTEGER, INTENT(IN) :: IU, iter, neg_count
+          REAL(q), INTENT(IN) :: epot, fmax, min_eig, delta, step_norm, cos_es
+          CHARACTER(LEN=*), INTENT(IN) :: phase
+          WRITE(IU,'(3X,A,I6,2X,A,1X,E14.6,2X,A,1X,E12.4,2X,A,I2,2X,A,1X,E12.4,2X,A,1X,A)') &
+            'CCQN-TS step', iter, 'F=', epot, 'Fmax=', fmax, 'neg=', neg_count, &
+            'minEig=', min_eig, 'phase=', phase
+          WRITE(IU,'(3X,A,1X,E12.4,2X,A,1X,E12.4,2X,A,1X,F8.4)') &
+            'CCQN-TS delta=', delta, '||s||=', step_norm, 'cos(e,s)=', cos_es
+        END SUBROUTINE ccqn_write_status
+
+
+        SUBROUTINE ccqn_update_ratio_and_delta(n, b, g_prev, s_prev, denom)
+          ! Trust-radius update from the pred/actual energy-change ratio
+          ! (paper eq 19). Uses the CACHED eigenvalues, which at this point
+          ! still belong to the Hessian that generated s_prev.
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: b(n,n)
+          REAL(q), INTENT(IN) :: g_prev(n), s_prev(n)
+          REAL(q), INTENT(IN) :: denom
+          REAL(q), ALLOCATABLE :: bs(:)
+          REAL(q) :: pred, ratio
+          LOGICAL :: in_well_prev
+
+          IF (SUM(ABS(s_prev)) < 1E-14_q) RETURN
+
+          ALLOCATE(bs(n))
+          bs = MATMUL(b, s_prev)
+          pred = SUM(g_prev*s_prev) + 0.5_q*SUM(s_prev*bs)
+          DEALLOCATE(bs)
+
+          St%pred_last = pred
+          St%dE_last = denom
+
+          ratio = 0._q
+          IF (denom /= 0._q) ratio = pred / denom
+          St%ratio_last = ratio
+          St%have_ratio = .TRUE.
+
+          in_well_prev = (St%eval(1) > Inp%neg_eig_tol)
+          IF (.NOT. in_well_prev) THEN
+            St%delta = trust_radius_update(St%delta, ratio, Inp%rho_inc, Inp%rho_dec, &
+                                           Inp%sigma_inc, Inp%sigma_dec, Inp%delta_min, Inp%delta_max)
+          END IF
+        END SUBROUTINE ccqn_update_ratio_and_delta
+
+
+        REAL(q) FUNCTION trust_radius_update(delta, ratio, rho_inc, rho_dec, sigma_inc, &
+                                             sigma_dec, delta_min, delta_max)
+          REAL(q), INTENT(IN) :: delta, ratio, rho_inc, rho_dec, sigma_inc, sigma_dec
+          REAL(q), INTENT(IN) :: delta_min, delta_max
+          IF (ratio >= 1._q/rho_inc .AND. ratio <= rho_inc) THEN
+            trust_radius_update = MIN(delta_max, delta*sigma_inc)
+          ELSE IF (ratio <= 1._q/rho_dec .OR. ratio >= rho_dec) THEN
+            trust_radius_update = MAX(delta_min, delta*sigma_dec)
+          ELSE
+            trust_radius_update = delta
+          END IF
+        END FUNCTION trust_radius_update
+
+
+        SUBROUTINE ccqn_decompose_b(n)
+          ! The single O(n^3) eigendecomposition per ionic step.
+          INTEGER, INTENT(IN) :: n
+          St%b = 0.5_q*(St%b + TRANSPOSE(St%b))
+          St%evec = St%b
+          CALL dsyev_wrap('V', n, St%evec, St%eval)
+        END SUBROUTINE ccqn_decompose_b
+
+
+        SUBROUTINE ccqn_eval_diagnostics(n, eval, tol_well, tol_conv, neg_conv, min_eig, in_well)
+          ! O(n) diagnostics from cached eigenvalues.
+          ! tol_well: numerical-zero threshold for the well/inflection test.
+          ! tol_conv: physical threshold counting significant negative modes
+          !           (used in the convergence check; < 0 disables the count).
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: eval(n)
+          REAL(q), INTENT(IN) :: tol_well, tol_conv
+          INTEGER, INTENT(OUT) :: neg_conv
+          REAL(q), INTENT(OUT) :: min_eig
+          LOGICAL, INTENT(OUT) :: in_well
+
+          INTEGER :: i
+          REAL(q) :: tc
+
+          min_eig = eval(1)
+          in_well = (min_eig > tol_well)
+          tc = MAX(tol_conv, 0._q)
+          neg_conv = 0
+          DO i=1,n
+            IF (eval(i) < -tc) neg_conv = neg_conv + 1
+          END DO
+        END SUBROUTINE ccqn_eval_diagnostics
+
+
+        SUBROUTINE dsyev_wrap(jobz, n, a, w)
+          CHARACTER(LEN=1), INTENT(IN) :: jobz
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(INOUT) :: a(n,n)
+          REAL(q), INTENT(OUT) :: w(n)
+
+          INTEGER :: info, lwork
+          REAL(q), ALLOCATABLE :: work(:)
+          REAL(q) :: workq(1)
+
+          lwork = -1
+          CALL DSYEV(jobz, 'U', n, a, n, w, workq, lwork, info)
+          IF (info /= 0) CALL vtutor%bug("CCQN-TS: DSYEV query failed. INFO=" // str(info), &
+                                         __FILE__, __LINE__)
+          lwork = MAX(1, INT(workq(1)))
+          ALLOCATE(work(lwork))
+          CALL DSYEV(jobz, 'U', n, a, n, w, work, lwork, info)
+          DEALLOCATE(work)
+          IF (info /= 0) CALL vtutor%bug("CCQN-TS: DSYEV failed. INFO=" // str(info), &
+                                         __FILE__, __LINE__)
+        END SUBROUTINE dsyev_wrap
+
+
+        SUBROUTINE ts_bfgs_update(n, b, s, y, evec, eval)
+          ! TS-BFGS (paper eqs 4-6). |B|s is formed from the CACHED
+          ! eigendecomposition of the current B (no extra O(n^3) solve).
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(INOUT) :: b(n,n)
+          REAL(q), INTENT(IN) :: s(n), y(n)
+          REAL(q), INTENT(IN) :: evec(n,n), eval(n)
+
+          REAL(q), PARAMETER :: eps = 1E-12_q
+          REAL(q) :: sy, c, denom, js
+          REAL(q), ALLOCATABLE :: qts(:), tmp(:), tbs(:), bs(:), jv(:), u(:)
+          INTEGER :: i
+
+          IF (SUM(ABS(s)) < eps) RETURN
+
+          sy = SUM(s*y)
+          IF (ABS(sy) < eps) RETURN
+
+          ALLOCATE(qts(n), tmp(n), tbs(n), bs(n), jv(n), u(n))
+          qts = MATMUL(TRANSPOSE(evec), s)
+          DO i=1,n
+            tmp(i) = ABS(eval(i)) * qts(i)
+          END DO
+          tbs = MATMUL(evec, tmp)          ! |B| s
+          c = SUM(s*tbs)
+
+          denom = sy*sy + c*c
+          IF (ABS(denom) < eps) THEN
+            DEALLOCATE(qts, tmp, tbs, bs, jv, u)
+            RETURN
+          END IF
+
+          u = (y*sy + c*tbs) / denom
+
+          bs = MATMUL(b, s)
+          jv = y - bs
+          js = SUM(jv*s)
+
+          DO i=1,n
+            b(:,i) = b(:,i) + jv*u(i) + u*jv(i) - js*u*u(i)
+          END DO
+          b = 0.5_q*(b + TRANSPOSE(b))
+
+          DEALLOCATE(qts, tmp, tbs, bs, jv, u)
+        END SUBROUTINE ts_bfgs_update
+
+
+!=======================================================================
+!  Restricted-step PRFO in the eigenbasis (paper eqs 13-17).
+!  Uses the cached decomposition; no O(n^3) work inside.
+!    - Newton step taken directly when inside the trust region (eq 8).
+!    - Otherwise bisection on a for ||s(a)|| = delta, where s(a) is
+!      evaluated in closed form: 2x2 for the maximization subspace
+!      (mu = 1), secular equation for the minimization subspace.
+!=======================================================================
+
+        FUNCTION prfo_step(n, g, evec, eval, delta) RESULT(s)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: g(n), evec(n,n), eval(n), delta
+          REAL(q) :: s(n)
+
+          REAL(q), ALLOCATABLE :: gtil(:), stil(:)
+          REAL(q) :: a_lo, a_hi, a_mid, rn
+          INTEGER :: it
+
+          ALLOCATE(gtil(n), stil(n))
+          gtil = MATMUL(TRANSPOSE(evec), g)
+
+          ! Newton step if it lies inside the trust region (paper: eq 8)
+          IF (MINVAL(ABS(eval)) > 1E-12_q) THEN
+            stil = -gtil / eval
+            IF (SQRT(SUM(stil*stil)) <= delta) THEN
+              s = MATMUL(evec, stil)
+              DEALLOCATE(gtil, stil)
+              RETURN
+            END IF
+          END IF
+
+          ! r(a) = ||s(a)|| is strictly increasing in a; log-bisection.
+          a_lo = 1E-8_q
+          a_hi = 1E8_q
+          DO it=1,200
+            a_mid = SQRT(a_lo*a_hi)
+            CALL prfo_tilde_step(n, eval, gtil, a_mid, stil)
+            rn = SQRT(SUM(stil*stil))
+            IF (rn < delta) THEN
+              a_lo = a_mid
+            ELSE
+              a_hi = a_mid
+            END IF
+            IF (a_hi/a_lo < 1._q + 1E-14_q) EXIT
+          END DO
+          a_mid = SQRT(a_lo*a_hi)
+          CALL prfo_tilde_step(n, eval, gtil, a_mid, stil)
+          s = MATMUL(evec, stil)
+          DEALLOCATE(gtil, stil)
+        END FUNCTION prfo_step
+
+
+        SUBROUTINE prfo_tilde_step(n, eval, gtil, a, stil)
+          ! Step in the eigenbasis for a given RFO scaling parameter a.
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: eval(n), gtil(n), a
+          REAL(q), INTENT(OUT) :: stil(n)
+
+          REAL(q) :: p, disc, th_max, th_min, den, gmax, tau
+          INTEGER :: i
+
+          stil = 0._q
+
+          ! --- maximization subspace: lowest mode (mu = 1), 2x2 closed form
+          p = a*a*eval(1)
+          disc = SQRT(p*p + 4._q*a*a*gtil(1)*gtil(1))
+          th_max = 0.5_q*(p + disc)
+          den = th_max - p
+          IF (den > 1E-300_q) stil(1) = a*a*gtil(1) / den
+
+          IF (n == 1) RETURN
+
+          ! --- minimization subspace: secular equation for the lowest
+          !     eigenvalue of the arrowhead matrix
+          gmax = 0._q
+          DO i=2,n
+            gmax = MAX(gmax, ABS(gtil(i)))
+          END DO
+          tau = 1E-13_q * MAX(gmax, 1._q)
+
+          CALL theta_min_secular(n-1, eval(2:n), gtil(2:n), a, tau, th_min)
+
+          DO i=2,n
+            IF (ABS(gtil(i)) > tau) THEN
+              stil(i) = a*a*gtil(i) / (th_min - a*a*eval(i))
+            END IF
+          END DO
+        END SUBROUTINE prfo_tilde_step
+
+
+        SUBROUTINE theta_min_secular(m, lam, gt, a, tau, theta)
+          ! Lowest eigenvalue of [[a^2 diag(lam), a gt],[a gt^T, 0]].
+          ! f(th) = th - sum_i a^2 gt_i^2/(th - a^2 lam_i) is strictly
+          ! increasing on (-inf, min_i a^2 lam_i) over contributing modes;
+          ! modes with |gt_i| <= tau are exact (trivial) eigen-directions
+          ! and are excluded (their step component is zero).
+          INTEGER, INTENT(IN) :: m
+          REAL(q), INTENT(IN) :: lam(m), gt(m), a, tau
+          REAL(q), INTENT(OUT) :: theta
+
+          REAL(q) :: dmin, lo, hi, th, f, gn2
+          INTEGER :: i, it
+          LOGICAL :: found
+
+          found = .FALSE.
+          dmin = 0._q
+          gn2 = 0._q
+          DO i=1,m
+            IF (ABS(gt(i)) > tau) THEN
+              IF (.NOT. found) THEN
+                dmin = a*a*lam(i)
+                found = .TRUE.
+              ELSE
+                dmin = MIN(dmin, a*a*lam(i))
+              END IF
+              gn2 = gn2 + gt(i)*gt(i)
+            END IF
+          END DO
+
+          IF (.NOT. found) THEN
+            ! No gradient component: lowest eigenvalue of the block-diagonal
+            ! matrix; the step in this subspace is zero anyway.
+            theta = MIN(a*a*lam(1), 0._q)
+            RETURN
+          END IF
+
+          lo = dmin - a*SQRT(gn2) - 1._q
+          hi = dmin
+          DO it=1,200
+            th = 0.5_q*(lo + hi)
+            f = th
+            DO i=1,m
+              IF (ABS(gt(i)) > tau) THEN
+                f = f - a*a*gt(i)*gt(i) / (th - a*a*lam(i))
+              END IF
+            END DO
+            IF (f < 0._q) THEN
+              lo = th
+            ELSE
+              hi = th
+            END IF
+            IF (hi - lo < 1E-14_q*MAX(1._q, ABS(dmin))) EXIT
+          END DO
+          theta = 0.5_q*(lo + hi)
+        END SUBROUTINE theta_min_secular
+
+
+!=======================================================================
+!  Cone-constrained step in the well phase (paper eqs 9a-9c and
+!  Algorithm 1). Outer ALM identical to the paper; the inner argmin
+!  uses Barzilai-Borwein spectral steps with a nonmonotone Armijo
+!  safeguard. sigma0 = 10 so that the precision schedule eta_t, eps_t
+!  actually tightens (with sigma0 = 1 and a feasible start the schedule
+!  degenerates and the subproblem is returned unconverged).
+!  Warm start (s, lambda, mu) carries over between consecutive well
+!  steps via module state; invalidated on any PRFO step.
+!=======================================================================
+
+        FUNCTION solve_cone_step_alm(n, g, b, e, delta, cos_phi) RESULT(s)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: g(n), b(n,n), e(n), delta, cos_phi
+          REAL(q) :: s(n)
+
+          REAL(q) :: lam, mu, sigma, eta_t, eps_t, grad_norm, nu
+          REAL(q), PARAMETER :: sigma0 = 10._q, rho = 10._q, alpha = 0.5_q, beta = 1._q
+          REAL(q), PARAMETER :: eps = 1E-6_q, eta = 1E-6_q
+          INTEGER, PARAMETER :: max_outer = 50, max_inner = 200, ls_max = 20
+          INTEGER :: it
+
+          IF (St%ws_valid) THEN
+            s = St%ws_s
+            CALL cone_project(n, s, e, delta, cos_phi, CCQN_EPSR)
+            lam = St%ws_lam
+            mu = St%ws_mu
+          ELSE
+            s = delta * e
+            lam = 0._q
+            mu = 0._q
+          END IF
+          sigma = sigma0
+          eta_t = sigma**(-1._q)
+          eps_t = sigma**(-alpha)
+
+          DO it=1,max_outer
+            CALL minimize_alm_bb(n, s, g, b, e, delta, cos_phi, lam, mu, sigma, &
+                                 MAX(eta_t, CCQN_EPSR), max_inner, ls_max, grad_norm)
+            CALL cone_violation(n, s, e, delta, cos_phi, CCQN_EPSR, nu, mu, sigma)
+            IF (nu <= eps_t) THEN
+              IF (nu <= eps .AND. grad_norm <= eta) EXIT
+              CALL cone_update_multipliers(n, s, e, delta, cos_phi, CCQN_EPSR, lam, mu, sigma)
+              eta_t = MAX(eta_t/sigma, eta)
+              eps_t = MAX(eps_t/(sigma**beta), eps)
+            ELSE
+              sigma = MIN(1E6_q, sigma*rho)
+              eta_t = MAX(eta_t/sigma, eta)
+              eps_t = MAX(eps_t/(sigma**alpha), eps)
+            END IF
+          END DO
+
+          ! Cache the unprojected KKT point and multipliers for warm starting
+          St%ws_s = s
+          St%ws_lam = lam
+          St%ws_mu = mu
+          St%ws_valid = .TRUE.
+
+          CALL cone_project(n, s, e, delta, cos_phi, CCQN_EPSR)
+        END FUNCTION solve_cone_step_alm
+
+
+        SUBROUTINE minimize_alm_bb(n, s, g, b, e, delta, cos_phi, lam, mu, sigma, &
+                                   grad_tol, max_inner, ls_max, grad_norm)
+          ! Inner solver: BB1 spectral step + nonmonotone Armijo (window M),
+          ! fallback backtracking from the spectral step; stops when the
+          ! augmented-Lagrangian gradient norm reaches grad_tol.
+          INTEGER, INTENT(IN) :: n, max_inner, ls_max
+          REAL(q), INTENT(INOUT) :: s(n)
+          REAL(q), INTENT(IN) :: g(n), b(n,n), e(n), delta, cos_phi, lam, mu, sigma, grad_tol
+          REAL(q), INTENT(OUT) :: grad_norm
+
+          INTEGER, PARAMETER :: MHIST = 8
+          REAL(q), ALLOCATABLE :: grad(:), s_new(:), grad_new(:), s_old(:), grad_old(:)
+          REAL(q) :: lval, lnew, step, alpha_bb, f_ref, dsy
+          REAL(q) :: hist(MHIST)
+          INTEGER :: it, ls, nh
+          LOGICAL :: have_prev, accepted
+
+          ALLOCATE(grad(n), s_new(n), grad_new(n), s_old(n), grad_old(n))
+          CALL alm_value_grad(n, s, g, b, e, delta, cos_phi, lam, mu, sigma, CCQN_EPSR, &
+                              lval, grad, grad_norm)
+          hist = lval
+          nh = 1
+          alpha_bb = 0.5_q
+          have_prev = .FALSE.
+
+          DO it=1,max_inner
+            IF (grad_norm <= grad_tol) EXIT
+
+            IF (have_prev) THEN
+              s_old = s - s_old            ! delta s
+              grad_old = grad - grad_old   ! delta grad
+              dsy = SUM(s_old*grad_old)
+              IF (dsy > 1E-30_q) THEN
+                alpha_bb = MIN(MAX(SUM(s_old*s_old)/dsy, 1E-6_q), 1E3_q)
+              ELSE
+                alpha_bb = 0.5_q
+              END IF
+            END IF
+
+            f_ref = MAXVAL(hist(1:MIN(nh,MHIST)))
+            step = alpha_bb
+            accepted = .FALSE.
+            DO ls=1,ls_max
+              s_new = s - step*grad
+              CALL alm_value_grad(n, s_new, g, b, e, delta, cos_phi, lam, mu, sigma, &
+                                  CCQN_EPSR, lnew, grad_new, grad_norm)
+              IF (lnew <= f_ref - 1E-4_q*step*SUM(grad*grad)) THEN
+                accepted = .TRUE.
+                EXIT
+              END IF
+              step = step*0.5_q
+            END DO
+            IF (.NOT. accepted) EXIT       ! hand control back to the outer loop
+
+            s_old = s
+            grad_old = grad
+            have_prev = .TRUE.
+            s = s_new
+            grad = grad_new
+            lval = lnew
+            grad_norm = SQRT(SUM(grad*grad))
+            nh = nh + 1
+            hist(1 + MOD(nh-1, MHIST)) = lval
+          END DO
+
+          grad_norm = SQRT(SUM(grad*grad))
+          DEALLOCATE(grad, s_new, grad_new, s_old, grad_old)
+        END SUBROUTINE minimize_alm_bb
+
+
+        SUBROUTINE alm_value_grad(n, s, g, b, e, delta, cos_phi, lam, mu, sigma, epsr, &
+                                  lval, grad, grad_norm)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: s(n), g(n), b(n,n), e(n), delta, cos_phi, lam, mu, sigma, epsr
+          REAL(q), INTENT(OUT) :: lval, grad(n), grad_norm
+
+          REAL(q), ALLOCATABLE :: bs(:), grad_ceq(:), grad_cin(:)
+          REAL(q) :: r, c_eq, c_ineq, t, fquad
+
+          ALLOCATE(bs(n), grad_ceq(n), grad_cin(n))
+          CALL cone_terms(n, s, e, delta, cos_phi, epsr, r, c_eq, c_ineq, grad_ceq, grad_cin)
+          bs = MATMUL(b, s)
+          fquad = SUM(g*s) + 0.5_q*SUM(s*bs)
+          t = MAX(mu/sigma + c_ineq, 0._q)
+          lval = fquad + lam*c_eq + 0.5_q*sigma*c_eq*c_eq + 0.5_q*sigma*(t*t - (mu/sigma)*(mu/sigma))
+          grad = g + bs + (lam + sigma*c_eq)*grad_ceq + sigma*t*grad_cin
+          grad_norm = SQRT(SUM(grad*grad))
+          DEALLOCATE(bs, grad_ceq, grad_cin)
+        END SUBROUTINE alm_value_grad
+
+
+        SUBROUTINE cone_terms(n, s, e, delta, cos_phi, epsr, r, c_eq, c_ineq, grad_ceq, grad_cin)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: s(n), e(n), delta, cos_phi, epsr
+          REAL(q), INTENT(OUT) :: r, c_eq, c_ineq, grad_ceq(n), grad_cin(n)
+
+          r = SQRT(SUM(s*s))
+          IF (r < epsr) r = epsr
+          c_eq = r - delta
+          c_ineq = r*cos_phi - SUM(e*s)
+          grad_ceq = s / r
+          grad_cin = cos_phi*s / r - e
+        END SUBROUTINE cone_terms
+
+
+        SUBROUTINE cone_project(n, s, e, delta, cos_phi, epsr)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(INOUT) :: s(n)
+          REAL(q), INTENT(IN) :: e(n), delta, cos_phi, epsr
+
+          REAL(q) :: r, dot, a_target, b_target, b
+          REAL(q), ALLOCATABLE :: perp(:)
+
+          IF (delta <= 0._q) THEN
+            s = 0._q
+            RETURN
+          END IF
+
+          r = SQRT(SUM(s*s))
+          IF (r < epsr) THEN
+            s = delta * e
+            RETURN
+          END IF
+          s = s * (delta / r)
+
+          dot = SUM(e*s)
+          a_target = delta * cos_phi
+          IF (dot >= a_target - 1E-12_q) RETURN
+
+          ALLOCATE(perp(n))
+          perp = s - dot*e
+          b = SQRT(SUM(perp*perp))
+
+          IF (b < epsr) THEN
+            perp = 0._q
+            perp(1) = 1._q
+            perp = perp - SUM(perp*e)*e
+            b = SQRT(SUM(perp*perp))
+            IF (b < epsr .AND. n >= 2) THEN
+              perp = 0._q
+              perp(2) = 1._q
+              perp = perp - SUM(perp*e)*e
+              b = SQRT(SUM(perp*perp))
+            END IF
+            IF (b < epsr .AND. n >= 3) THEN
+              perp = 0._q
+              perp(3) = 1._q
+              perp = perp - SUM(perp*e)*e
+              b = SQRT(SUM(perp*perp))
+            END IF
+          END IF
+
+          IF (b < epsr) THEN
+            perp = 0._q
+            perp(1) = 1._q
+            b = 1._q
+          END IF
+
+          b_target = SQRT(MAX(delta*delta - a_target*a_target, 0._q))
+          s = a_target*e + (b_target/b)*perp
+          DEALLOCATE(perp)
+        END SUBROUTINE cone_project
+
+
+        SUBROUTINE cone_violation(n, s, e, delta, cos_phi, epsr, nu, mu, sigma)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: s(n), e(n), delta, cos_phi, epsr, mu, sigma
+          REAL(q), INTENT(OUT) :: nu
+
+          REAL(q), ALLOCATABLE :: gce(:), gci(:)
+          REAL(q) :: r, c_eq, c_ineq, t
+
+          ALLOCATE(gce(n), gci(n))
+          CALL cone_terms(n, s, e, delta, cos_phi, epsr, r, c_eq, c_ineq, gce, gci)
+          IF (sigma > 0._q) THEN
+            t = MAX(c_ineq, -mu/sigma)
+          ELSE
+            t = MAX(c_ineq, 0._q)
+          END IF
+          nu = SQRT(c_eq*c_eq + t*t)
+          DEALLOCATE(gce, gci)
+        END SUBROUTINE cone_violation
+
+
+        SUBROUTINE cone_update_multipliers(n, s, e, delta, cos_phi, epsr, lam, mu, sigma)
+          INTEGER, INTENT(IN) :: n
+          REAL(q), INTENT(IN) :: s(n), e(n), delta, cos_phi, epsr, sigma
+          REAL(q), INTENT(INOUT) :: lam, mu
+
+          REAL(q), ALLOCATABLE :: gce(:), gci(:)
+          REAL(q) :: r, c_eq, c_ineq
+
+          ALLOCATE(gce(n), gci(n))
+          CALL cone_terms(n, s, e, delta, cos_phi, epsr, r, c_eq, c_ineq, gce, gci)
+          lam = lam + sigma*c_eq
+          mu = MAX(mu + sigma*c_ineq, 0._q)
+          DEALLOCATE(gce, gci)
+        END SUBROUTINE cone_update_multipliers
+
+!-----------------------------------------------------------------------
+! Local uppercase helper (avoids dependency on string module's uppercase,
+! which is absent in VASP 6.1.x)
+!-----------------------------------------------------------------------
+        PURE FUNCTION ccqn_uppercase(s) RESULT(res)
+          CHARACTER(LEN=*), INTENT(IN) :: s
+          CHARACTER(LEN=LEN(s)) :: res
+          INTEGER :: i, ic
+          res = s
+          DO i = 1, LEN_TRIM(s)
+            ic = IACHAR(s(i:i))
+            IF (ic >= IACHAR('a') .AND. ic <= IACHAR('z')) &
+     &        res(i:i) = ACHAR(ic - 32)
+          END DO
+        END FUNCTION ccqn_uppercase
+
+      END MODULE ccqn_ts
